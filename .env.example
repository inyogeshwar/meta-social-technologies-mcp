# Meta Permanent Page Access Token (Facebook & Instagram Graph API)
FB_PAGE_ACCESS_TOKEN=your_permanent_page_access_token_here

# Facebook Page ID (e.g. 123456789012345)
FB_PAGE_ID=your_facebook_page_id_here

# Instagram Business/Creator Account Scoped ID (e.g. 17841400000000000)
INSTAGRAM_ID=your_instagram_account_id_here

# Threads User Access Token (from graph.threads.net)
THREADS_ACCESS_TOKEN=your_threads_access_token_here

# Threads Account ID (e.g. 1234567890123456)
THREADS_USER_ID=your_threads_account_id_here

# Target Test Recipient IGSID (Optional, for running DM tests)
TEST_RECIPIENT_ID=your_test_recipient_igsid_here
